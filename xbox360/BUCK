load("//build_defs:xbox360_module.bzl", "xbox360_module")

_MODULE = "//crates/openxbdm-server-xbox360:openxbdm-server-xbox360"

# For the kd host (DEVELOPING.md, Console deployment).
xbox360_module(
    name = "openxbdm",
    executable = _MODULE + "-bin",
    manifest = "xex.toml",
    out = "openxbdm.xex",
    visibility = ["PUBLIC"],
)

# For DEVKIT:\FlashEx. `boot-guard` is the module's only feature outside
# the defaults, so the `-all-features` executable is the boot-guard build.
xbox360_module(
    name = "openxbdm-boot-guard",
    executable = _MODULE + "-all-features-bin",
    manifest = "xex.toml",
    out = "openxbdm-boot-guard.xex",
    visibility = ["PUBLIC"],
)

# Without the save and restore rewrite.
xbox360_module(
    name = "openxbdm-no-rewrite",
    executable = _MODULE + "-bin",
    manifest = "xex.toml",
    out = "openxbdm-no-rewrite.xex",
    rewrite = False,
)

# Retail, loaded as a dashlaunch plugin (docs/re-notes/retail-dashlaunch.md).
xbox360_module(
    name = "openxbdm-dashlaunch",
    executable = _MODULE + "-dashlaunch-bin",
    manifest = "xex-dashlaunch.toml",
    out = "openxbdm-dashlaunch.xex",
)

# Temporary: dashlaunch + trace-log, for diagnosing the startup failure
# recorded in docs/re-notes/retail-dashlaunch.md. Remove once resolved.
xbox360_module(
    name = "openxbdm-dashlaunch-trace",
    executable = _MODULE + "-dashlaunch-trace-bin",
    manifest = "xex-dashlaunch.toml",
    out = "openxbdm-dashlaunch-trace.xex",
)
